{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "repositories": [
        {
            "type": "path",
            "url": "./packages/laravel-comments"
        },
        {
            "type": "path",
            "url": "./packages/laravel-rating"
        }
    ],
    "license": "MIT",
    "require": {
        "arandilopez/laravel-profane": "^0.5.0",
        "artesaos/seotools": "^1.4",
        "blade-ui-kit/blade-icons": "^1.0",
        "christiankuri/laravel-favorite": "^1.4",
        "creativeorange/gravatar": "^1.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "hazzard/laravel-comments": "dev-master",
        "kyslik/column-sortable": "^8.0",
        "laravel/framework": "^11.45.3",
        "laravel/passport": "^13.11",
        "laravel/tinker": "^2.5",
        "laravel/ui": "^4.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "mll-lab/graphql-php-scalars": "^6.5",
        "nagy/laravel-rating": "2.2.1",
        "nuwave/lighthouse": "^6.74",
        "php": "^8.2",
        "rollbar/rollbar-laravel": "^8.1",
        "spatie/laravel-backup": "^8.0",
        "spatie/laravel-permission": "^6.0",
        "tucker-eric/eloquentfilter": "^3.0",
        "filament/filament": "^5.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.0",
        "barryvdh/laravel-ide-helper": "^3.0",
        "fakerphp/faker": "^1.9.1",
        "friendsofphp/php-cs-fixer": "^3.0",
        "haydenpierce/class-finder": "^0.4.2",
        "laravel/dusk": "^8.0",
        "mockery/mockery": "^1.4.2",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0",
        "spatie/laravel-ignition": "^2.0",
        "mll-lab/laravel-graphiql": "^3.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "check-style": "php-cs-fixer fix --dry-run --diff",
        "fix-style": "php-cs-fixer fix",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
